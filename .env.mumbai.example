# Mumbai Testnet Configuration
# Copy this file to .env and fill in your values

# ==========================================
# Database Configuration
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=skillbadge
DB_PASSWORD=dev_password_change_me
DB_NAME=skillbadge_db

# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ==========================================
# Blockchain - Mumbai Testnet
# ==========================================
# Get MATIC from: https://faucet.polygon.technology/
POLYGON_RPC_URL=https://rpc-mumbai.maticvigil.com
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Your wallet private key (DO NOT share this!)
# Export from MetaMask: Account > Export Private Key
PRIVATE_KEY=your_testnet_private_key_here

# Contract address (will be set after deployment)
CONTRACT_ADDRESS=0x...

# ==========================================
# IPFS Storage
# ==========================================
# Get token from: https://nft.storage/
NFT_STORAGE_TOKEN=your_nft_storage_token_here

# ==========================================
# API Configuration
# ==========================================
PORT=3001
NODE_ENV=development

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Frontend Web3 Configuration
NEXT_PUBLIC_POLYGON_RPC=https://rpc-mumbai.maticvigil.com
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# ==========================================
# Optional: Contract Verification
# ==========================================
# Get API key from: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ==========================================
# Network Information
# ==========================================
# Mumbai Testnet
# Chain ID: 80001
# Block Explorer: https://mumbai.polygonscan.com/
# Faucet: https://faucet.polygon.technology/
# Network Name: Mumbai
